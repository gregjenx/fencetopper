---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { colors, assetVersion } from '../data/site';
import HeightStepper from '../components/HeightStepper.astro';
---
<Base title="See a Fence Extension on Your Fence" path="/visualizer" breadcrumb="Visualizer"
  description="Upload a photo of your fence and preview a FenceTopper privacy extension to scale in Carbon, Black, Evergreen or Brown at any height from 12 to 24 inches.">
  <section class="page-head wrap">
    <span class="eyebrow">Visualizer</span>
    <h1>Picture it on your fence.</h1>
    <p class="lead">Upload a photo, drag the yellow handles to the top of your fence and the blue handles to the bottom, then try different heights and colors. The topper is drawn to scale from your fence height.</p>
  </section>

  <section class="section-tight">
    <div class="wrap viz-tool">
      <div style="display:grid;gap:12px">
        <div class="viz-stage" id="viz-stage">
          <canvas id="viz-canvas" width="1600" height="1000" role="img" aria-label="Your fence with a FenceTopper drawn above it"></canvas>
        </div>
        <p class="viz-help viz-readout" id="viz-readout" aria-live="polite"></p>
        <div class="viz-actions">
          <label class="btn btn-primary" for="viz-file" style="cursor:pointer"><Icon name="upload" width="20" height="20" />Upload your photo</label>
          <input id="viz-file" type="file" accept="image/*" class="sr-only" />
          <button class="btn btn-outline" type="button" id="viz-compare" aria-pressed="false">Show before</button>
        </div>
        <div class="viz-samples" role="group" aria-labelledby="viz-samples-label">
          <span class="label" id="viz-samples-label">No photo handy? Try a sample yard</span>
          <div class="viz-sample-row">
            <button type="button" class="viz-sample" data-sample="drawn" aria-pressed="true"><img alt="" width="240" height="150" /><span>Illustration</span></button>
            <button type="button" class="viz-sample" data-sample="pool" aria-pressed="false"><img src="/img/samples/pool-thumb.webp" alt="" width="240" height="180" loading="lazy" /><span>Poolside</span></button>
            <button type="button" class="viz-sample" data-sample="patio" aria-pressed="false"><img src="/img/samples/patio-thumb.webp" alt="" width="240" height="180" loading="lazy" /><span>Backyard patio</span></button>
          </div>
        </div>
        <p class="viz-help">Your photo stays on your device. Nothing is uploaded to our servers.</p>
      </div>

      <div class="panel">
        <HeightStepper id="viz-height" />
        <div class="field">
          <span class="label" id="lbl-c">Color</span>
          <div class="choice-row four" role="radiogroup" aria-labelledby="lbl-c">
            {colors.map((c, i) => (
              <label class="choice"><input type="radio" name="viz-color" value={c.id} checked={i === 0} /><span style="gap:6px"><i style={`display:block;width:100%;height:22px;border-radius:4px;background:${c.hex}`}></i>{c.name}</span></label>
            ))}
          </div>
        </div>
        <div class="field">
          <label for="viz-fence">Existing fence height</label>
          <select id="viz-fence">
            <option value="4">4 ft</option><option value="5">5 ft</option><option value="6" selected>6 ft</option><option value="7">7 ft</option><option value="8">8 ft</option>
          </select>
          <span class="hint">Used to draw the topper at the right size.</span>
        </div>
        <div class="field">
          <label for="viz-posts">Posts across the photo: <output id="viz-posts-out" for="viz-posts">4</output></label>
          <input id="viz-posts" type="range" min="2" max="12" value="4" />
        </div>
        <label style="display:flex;gap:10px;align-items:center;font-weight:600"><input id="viz-guides" type="checkbox" checked style="width:20px;height:20px" /> Show measuring handles</label>
        <div style="display:grid;gap:10px">
          <a class="btn btn-primary btn-block" href="/shop" id="viz-save">Price this topper</a>
          <button class="btn btn-outline btn-block" type="button" id="viz-reset">Reset handles</button>
        </div>
        <p class="note promo">AI auto-fit is coming: it will find your fence line for you. <span class="placeholder">Placeholder</span></p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap prose">
      <h2>Tips for a good preview photo</h2>
      <ul>
        <li>Stand where you sit or look out most, such as the patio or a window, so the preview shows the view you want to block.</li>
        <li>Keep the whole run of fence in the frame, with the top of the fence clearly visible.</li>
        <li>Take the photo in daylight, holding the phone level.</li>
      </ul>
    </div>
  </section>
  <script slot="scripts" is:inline src={`/js/visualizer.js?v=${assetVersion}`} defer></script>
</Base>
