---
// FenceTopper logo (final mark P1): FT monogram + "FenceTopper" wordmark.
// The T bar ("Topper") reaches over a corner-shaped F ("Fence"). Every line is 14 units
// thick, with two equal 4-unit gaps. Fills follow the theme tokens.
// The mark is sized in em of the wordmark, so set only font-size on .logo to resize it.
// Wrap it in the link that carries the accessible name: <a class="logo" aria-label="FenceTopper home">.
---
<svg viewBox="0 0 62 50" aria-hidden="true" focusable="false" class="logo-mark">
  <rect x="0" y="18" width="14" height="32" fill="var(--logo-fence)"/>
  <rect x="0" y="18" width="34.5" height="14" fill="var(--logo-fence)"/>
  <rect x="38.5" y="0" width="14" height="50" fill="var(--logo-topper)"/>
  <rect x="0" y="0" width="62" height="14" fill="var(--logo-topper)"/>
</svg>
<span class="logo-name"><span class="logo-fence">Fence</span><span class="logo-topper">Topper</span></span>
