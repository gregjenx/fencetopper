---
import { brand, nav, footerNav, assetVersion, pricing, features, forms } from '../data/site';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';

interface Props {
  title: string;
  description: string;
  path: string;            // e.g. '/measure'
  image?: string;
  schema?: object[];       // page-specific JSON-LD
  breadcrumb?: string;     // label for BreadcrumbList; omitted on home
  noindex?: boolean;
  variant?: 'site' | 'staff'; // staff: compact staff header, no footer or chat
}
const { title, description, path, image = '/img/og.jpg', schema = [], breadcrumb, noindex = false, variant = 'site' } = Astro.props;
const staff = variant === 'staff';
const staffNav = [{ href: '/staff', label: 'Queue' }, { href: '/staff-rates', label: 'Rates' }];
const canonical = brand.url + (path === '/' ? '/' : path);
const fullTitle = path === '/' ? `${brand.name} | ${brand.tagline.replace(/\.$/, '')}` : `${title} | ${brand.name}`;

const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': brand.url + '/#org',
  name: brand.name,
  url: brand.url,
  logo: brand.url + '/favicon.svg',
  slogan: brand.tagline,
  email: brand.email,
};
const site = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: brand.name,
  url: brand.url,
  publisher: { '@id': brand.url + '/#org' },
};
const crumbs = breadcrumb && {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: brand.url + '/' },
    { '@type': 'ListItem', position: 2, name: breadcrumb, item: canonical },
  ],
};
const ld = [org, site, crumbs, ...schema].filter(Boolean);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
  <meta name="theme-color" content="#12482b" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={brand.name} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={brand.url + image} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Manrope:wght@700;800&display=swap" />
  <link rel="stylesheet" href={`/css/site.css?v=${assetVersion}`} />
  {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
</head>
<body class={staff ? 'is-staff' : undefined}>
  <a class="skip" href="#main">Skip to content</a>
  {staff ? (
  <header class="staff-header">
    <div class="wrap staff-bar">
      <a class="logo" href="/staff" aria-label="FenceTopper staff home"><Logo /></a>
      <span class="staff-tag">Staff</span>
      <nav class="staff-nav" aria-label="Staff">
        {staffNav.map((n) => <a href={n.href} aria-current={n.href === path ? 'page' : undefined}>{n.label}</a>)}
        <a href="/">View site</a>
      </nav>
    </div>
  </header>
  ) : (<Fragment>
  <div class="announce">Custom Toppers for Existing Fences.</div>
  <header class="site-header">
    <div class="wrap header-bar">
      <a class="logo" href="/" aria-label={`${brand.name} home`}>
        <Logo />
      </a>
      <nav class="main-nav" aria-label="Main">
        {nav.map((n) => <a href={n.href} aria-current={n.href === path ? 'page' : undefined}>{n.label}</a>)}
      </nav>
      <div class="header-actions">
        {features.builder && (
        <a class="icon-btn" href="/projects" aria-label="My projects" data-account-link>
          <Icon name="user" />
        </a>
        )}
        <a class="icon-btn" href="/cart" aria-label="Cart">
          <Icon name="cart" />
          <span class="cart-count" data-cart-count hidden>0</span>
        </a>
        <button class="icon-btn menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Menu" data-menu-toggle>
          <Icon name="menu" />
        </button>
      </div>
    </div>
    <nav id="mobile-nav" class="mobile-nav wrap" aria-label="Mobile" hidden>
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      <a href="/support">Support</a>
      {features.builder && <a href="/projects">My projects</a>}
      <a class="btn btn-primary btn-block" href="/shop">Order Now</a>
    </nav>
  </header>
  </Fragment>)}

  <main id="main">
    <slot />
  </main>

  {!staff && (<Fragment>
  <footer class="site-footer">
    <div class="wrap footer-grid">
      <div class="footer-meta">
        <a class="logo" href="/" aria-label={`${brand.name} home`}><Logo /></a>
        <p style="margin-top:10px">{brand.tagline}</p>
        <p>{brand.domain}</p>
      </div>
      <nav class="footer-links" aria-label="Footer">
        {footerNav.map((n) => <a href={n.href}>{n.label}</a>)}
        <a href="/shop">Shop</a>
        <a href="/faq">FAQ</a>
        <a href="/visualizer">Visualizer</a>
      </nav>
    </div>
    <div class="wrap footer-meta" style="margin-top:24px">
      <p>© {new Date().getFullYear()} {brand.name}. All rights reserved.</p>
    </div>
  </footer>

  <button class="chat-launcher" type="button" data-chat-open aria-controls="chat-panel">
    <Icon name="chat" /><span class="launcher-text">Ask FenceTopper</span>
  </button>
  <section id="chat-panel" class="chat chat-panel" aria-label="FenceTopper help chat" hidden data-chat="panel">
    <div class="chat-head">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 690.0 491.0" class="logo-mark on-green" aria-hidden="true"><rect width="690" height="491" class="ft-box"/><g transform="translate(117.5 130)"><rect x="0" y="0" width="455" height="52" class="ft-mark"/><rect x="0" y="0" width="58" height="231" class="ft-mark"/><rect x="0" y="86" width="157" height="52" class="ft-mark"/><rect x="259" y="0" width="57" height="231" class="ft-mark"/></g></svg>
      <div>FenceTopper help<small>Measuring, fit, color and installation</small></div>
      <button type="button" data-chat-close aria-label="Close chat">×</button>
    </div>
    <div class="chat-log" data-chat-log aria-live="polite"></div>
    <div class="chips" data-chat-chips></div>
    <form class="chat-form" data-chat-form>
      <label class="sr-only" for="chat-input-panel">Message</label>
      <input id="chat-input-panel" type="text" placeholder="Ask a question…" autocomplete="off" />
      <button type="submit" aria-label="Send"><Icon name="send" width="20" height="20" /></button>
    </form>
  </section>
  </Fragment>)}

  <script is:inline define:vars={{ pricing, features, forms }}>window.FT_PRICING = pricing; window.FT_FEATURES = features; window.FT_FORMS = forms;</script>
  <script is:inline src={`/js/site.js?v=${assetVersion}`} defer></script>
  <slot name="scripts" />
</body>
</html>
